# THE FAMILY APP — build configuration
#
# Copy this file to '.env' and fill it in for the school this build is for.
# Everything here is compiled into the APK and can be read by anyone who
# downloads it, so nothing secret belongs in this file. Ever.

# --- The school this build is branded for -----------------------------
# One codebase, one branded app per school. These are what the login screen
# shows before anyone has signed in, so they cannot come from the server.
EXPO_PUBLIC_SCHOOL_NAME=Nabisunsa Girls' Secondary School
EXPO_PUBLIC_SCHOOL_SHORT_NAME=Nabisunsa
EXPO_PUBLIC_SCHOOL_MOTTO=Empowerment Through Education
EXPO_PUBLIC_SCHOOL_CONTACT_EMAIL=admin@nabisunsagirls.ac.ug

# --- Firebase ---------------------------------------------------------
# Being retired. Auth, marks and school data now come from the school's own
# server; these keys remain only for the screens still being migrated.
# Android push notifications are a separate matter — Expo delivers those
# through FCM, which needs a Firebase project per branded app.

EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Where the school server lives. Public configuration, not a secret: a
# branded build points at that school's host.
EXPO_PUBLIC_API_BASE_URL=https://school.midwayug.com

# NOTE: there is deliberately no Gemini key here any more.
#
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and can be
# read by anyone who downloads the APK. The academic advisor now runs on the
# server, which holds the key as GEMINI_API_KEY in server/.env.production.
