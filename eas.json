{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "remote" },
  "build": {
    "base-production": {
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true
    },
    "base-preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "base-development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },

    "nabisunsa-girls": {
      "extends": "base-preview",
      "env": { "SCHOOL": "nabisunsa-girls" }
    },
    "nabisunsa-girls-production": {
      "extends": "base-production",
      "env": { "SCHOOL": "nabisunsa-girls" }
    }
  },
  "submit": { "production": {} }
}
