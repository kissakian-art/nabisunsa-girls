# Director of Studies portal
#
# On the VPS this runs as a container on the shared `web` network, so the
# host is the mysql container name, not localhost.
DATABASE_URL="mysql://school:CHANGE_ME@mysql:3306/midway_school"

# Signs session cookies. Generate with:  openssl rand -hex 32
# Changing it logs everyone out, which is the intended way to revoke sessions.
SESSION_SECRET="CHANGE_ME"

# Set to 1 only when serving over plain HTTP in local development.
# In production Caddy terminates HTTPS, so leave this unset.
ALLOW_INSECURE_COOKIES=
